<mxfile host="drawio"><diagram name="InstructGPT Fig 2" id="InstructGPT-Fig-2"><mxGraphModel grid="1" gridSize="10" page="0" math="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="endArrow=none;html=1;strokeColor=#EDEDED;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="406.50" y="11.40" as="sourcePoint"/><mxPoint x="406.50" y="754.20" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c3" value="" style="endArrow=none;html=1;strokeColor=#EDEDED;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="836.10" y="11.40" as="sourcePoint"/><mxPoint x="836.10" y="754.20" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c4" value='&lt;div style="line-height:18.00px"&gt;Step 1&lt;/div&gt;' style="text;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400;fontSize=15.00;fontColor=#000000;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10.20" y="8.35" width="360.00" height="22.00" as="geometry"/></mxCell><mxCell id="c5" value='&lt;div style="line-height:28.38px"&gt;Collect demonstration data,&lt;br&gt;and train a supervised policy.&lt;/div&gt;' style="text;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400;fontSize=21.30;fontColor=#000000;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10.20" y="36.59" width="360.00" height="60.76" as="geometry"/></mxCell><mxCell id="c6" value='&lt;div style="line-height:18.00px"&gt;Step 2&lt;/div&gt;' style="text;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400;fontSize=15.00;fontColor=#000000;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="443.40" y="8.35" width="360.00" height="22.00" as="geometry"/></mxCell><mxCell id="c7" value='&lt;div style="line-height:28.38px"&gt;Collect comparison data,&lt;br&gt;and train a reward model.&lt;/div&gt;' style="text;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400;fontSize=21.30;fontColor=#000000;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="443.40" y="36.59" width="360.00" height="60.76" as="geometry"/></mxCell><mxCell id="c8" value='&lt;div style="line-height:18.00px"&gt;Step 3&lt;/div&gt;' style="text;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400;fontSize=15.00;fontColor=#000000;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="869.40" y="8.35" width="360.00" height="22.00" as="geometry"/></mxCell><mxCell id="c9" value='&lt;div style="line-height:28.38px"&gt;Optimize a policy against&lt;br&gt;the reward model using&lt;br&gt;reinforcement learning.&lt;/div&gt;' style="text;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400;fontSize=21.30;fontColor=#000000;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="869.40" y="36.59" width="360.00" height="89.14" as="geometry"/></mxCell><mxCell id="c10" value='&lt;div style="line-height:28.50px"&gt;A prompt is&lt;br&gt;sampled from our&lt;br&gt;prompt dataset.&lt;/div&gt;' style="text;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400;fontSize=19.80;fontColor=#000000;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10.50" y="156.46" width="192.00" height="89.50" as="geometry"/></mxCell><mxCell id="c11" value='&lt;div style="line-height:28.50px"&gt;A labeler&lt;br&gt;demonstrates the&lt;br&gt;desired output&lt;br&gt;behavior.&lt;/div&gt;' style="text;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400;fontSize=19.80;fontColor=#000000;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10.50" y="290.26" width="192.00" height="118.00" as="geometry"/></mxCell><mxCell id="c12" value='&lt;div style="line-height:28.50px"&gt;This data is used&lt;br&gt;to fine-tune GPT-3&lt;br&gt;with supervised&lt;br&gt;learning.&lt;/div&gt;' style="text;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400;fontSize=19.80;fontColor=#000000;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10.50" y="477.46" width="192.00" height="118.00" as="geometry"/></mxCell><mxCell id="c13" value='&lt;div style="line-height:28.50px"&gt;A prompt and&lt;br&gt;several model&lt;br&gt;outputs are&lt;br&gt;sampled.&lt;/div&gt;' style="text;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400;fontSize=19.80;fontColor=#000000;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="443.70" y="156.16" width="192.00" height="118.00" as="geometry"/></mxCell><mxCell id="c14" value='&lt;div style="line-height:28.50px"&gt;A labeler ranks&lt;br&gt;the outputs from&lt;br&gt;best to worst.&lt;/div&gt;' style="text;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400;fontSize=19.80;fontColor=#000000;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="443.70" y="411.46" width="192.00" height="89.50" as="geometry"/></mxCell><mxCell id="c15" value='&lt;div style="line-height:28.50px"&gt;This data is used&lt;br&gt;to train our&lt;br&gt;reward model.&lt;/div&gt;' style="text;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400;fontSize=19.80;fontColor=#000000;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="443.70" y="577.66" width="192.00" height="89.50" as="geometry"/></mxCell><mxCell id="c16" value='&lt;div style="line-height:28.50px"&gt;A new prompt&lt;br&gt;is sampled from&lt;br&gt;the dataset.&lt;/div&gt;' style="text;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400;fontSize=19.80;fontColor=#000000;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="869.70" y="156.46" width="192.00" height="89.50" as="geometry"/></mxCell><mxCell id="c17" value='&lt;div style="line-height:28.50px"&gt;The policy&lt;br&gt;generates&lt;br&gt;an output.&lt;/div&gt;' style="text;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400;fontSize=19.80;fontColor=#000000;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="869.70" y="278.26" width="192.00" height="89.50" as="geometry"/></mxCell><mxCell id="c18" value='&lt;div style="line-height:28.50px"&gt;The reward model&lt;br&gt;calculates a&lt;br&gt;reward for&lt;br&gt;the output.&lt;/div&gt;' style="text;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400;fontSize=19.80;fontColor=#000000;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="869.70" y="500.26" width="192.00" height="118.00" as="geometry"/></mxCell><mxCell id="c19" value='&lt;div style="line-height:28.50px"&gt;The reward is&lt;br&gt;used to update&lt;br&gt;the policy&lt;br&gt;using PPO.&lt;/div&gt;' style="text;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400;fontSize=19.80;fontColor=#000000;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="869.70" y="638.26" width="192.00" height="118.00" as="geometry"/></mxCell><mxCell id="c20" value='&lt;div style="line-height:16.80px"&gt;Explain the moon&lt;br&gt;landing to a 6 year old&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=21.60;fillColor=#CAE4F1;strokeColor=none;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400;fontSize=12.36;fontColor=#000000;align=center;verticalAlign=top;whiteSpace=wrap;spacing=0;spacingTop=38.06;spacingLeft=4.80;" vertex="1" parent="1"><mxGeometry x="207.60" y="164.40" width="165.00" height="87.60" as="geometry"/></mxCell><mxCell id="c21" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;" vertex="1" parent="1"><mxGeometry x="274.80" y="173.40" width="30.60" height="30.00" as="geometry"/></mxCell><mxCell id="c22" value='&lt;div style="line-height:16.80px"&gt;Some people went&lt;br&gt;to the moon...&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=21.60;fillColor=#F5F5F4;strokeColor=none;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400;fontSize=12.36;fontColor=#000000;align=center;verticalAlign=top;whiteSpace=wrap;spacing=0;spacingTop=92.36;spacingLeft=4.80;" vertex="1" parent="1"><mxGeometry x="207.60" y="297.60" width="165.00" height="142.80" as="geometry"/></mxCell><mxCell id="c23" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=0;aspect=fixed;vertic