bert Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DAlbert%2BSans%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400%3B1%2C700;fontSize=14.96;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1185.6" y="62.8" width="208.0" height="20.8" as="geometry"/></mxCell><mxCell id="g61" value='&lt;div style="line-height:15.36px;font-weight:500"&gt;&lt;font color="#C8783A"&gt;def&lt;/font&gt; align_arm&lt;font color="#B5524F"&gt;(&lt;/font&gt;&lt;font color="#7F7F7F"&gt;end_effector&lt;/font&gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color="#7F7F7F"&gt;keypoints&lt;/font&gt;&lt;font color="#B5524F"&gt;)&lt;/font&gt;:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;center = keypoints&lt;font color="#B5524F"&gt;[&lt;/font&gt;&lt;font color="#8B4A8C"&gt;0&lt;/font&gt;&lt;font color="#B5524F"&gt;]&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;dist = end_effector - center&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;cost = np.linalg.norm&lt;font color="#B5524F"&gt;(&lt;/font&gt;dist&lt;font color="#B5524F"&gt;)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color="#C8783A"&gt;return&lt;/font&gt; cost&lt;br&gt;&lt;font color="#C8783A"&gt;def&lt;/font&gt; grasp_obj&lt;font color="#B5524F"&gt;(&lt;/font&gt;...&lt;font color="#B5524F"&gt;)&lt;/font&gt;:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;...&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color="#C8783A"&gt;return&lt;/font&gt; cost&lt;/div&gt;' style="text;html=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJetBrains%2BMono%3Awght%40400%3B500;fontSize=10.08;fontColor=#141414;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="1192.8" y="79.52" width="196.0" height="138.24" as="geometry"/></mxCell><mxCell id="g62" value="..." style="text;html=1;fontFamily=Albert Sans;